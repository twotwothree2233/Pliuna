{
  "id": "extract",
  "description": "Extract pure text from one immutable same-task PDF resource. Creates a new text resource and host-bound provenance. Page positions are tool-reported, not verified truth. No OCR, rendering or links.",
  "when_to_use": "Only when the user explicitly requests reading or extracting a PDF. Import alone never starts extraction. Read the returned resource to obtain the text; partial results must be disclosed.",
  "input_schema": {
    "type": "object",
    "properties": {
      "resource_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "resource_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "resource_id": {
        "type": "string"
      },
      "page_count": {
        "type": "integer",
        "minimum": 1
      },
      "extracted_pages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "partial": {
        "type": "boolean"
      },
      "notice": {
        "type": "string",
        "maxLength": 2000
      },
      "location_verification": {
        "const": "tool_reported"
      }
    },
    "required": [
      "resource_id",
      "page_count",
      "extracted_pages",
      "partial",
      "notice",
      "location_verification"
    ],
    "additionalProperties": false
  },
  "effect": "read",
  "timeout_ms": 60000,
  "errors": [
    "PDF_INPUT_LIMIT",
    "PDF_INVALID_OR_UNSUPPORTED",
    "PDF_PASSWORD_REQUIRED",
    "PDF_NO_TEXT",
    "PDF_CANCELLED",
    "PDF_WORKER_FAILED",
    "PDF_ENCRYPTED_UNSUPPORTED"
  ],
  "examples": []
}
