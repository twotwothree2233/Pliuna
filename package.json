{
  "name": "trellis",
  "version": "0.1.0",
  "private": true,
  "description": "Local task harness",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm rebuild:electron && electron-vite dev",
    "build": "pnpm generate && pnpm typecheck && electron-vite build",
    "package:mac:arm64": "pnpm build && node scripts/package-macos.mjs",
    "generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm rebuild:node && vitest run",
    "test:electron": "pnpm rebuild:electron && pnpm build && playwright test",
    "rebuild:node": "node scripts/rebuild-node.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "verify:contracts": "python3 scripts/verify-contracts.py"
  },
  "dependencies": {
    "@pydantic/monty": "1.3.0",
    "ajv": "8.17.1",
    "better-sqlite3": "12.4.1",
    "css-tree": "3.1.0",
    "parse5": "8.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/css-tree": "2.3.11",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "38.2.2",
    "electron-builder": "26.4.0",
    "electron-vite": "4.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
