{
  "manifest_version": "0.1",
  "protocol_version": "0.1",
  "id": "pliuna.acceptance",
  "version": "1.0.0",
  "access_level": "task",
  "contributes": [
    { "id": "echo", "kind": "tool", "entry": "echo.json", "description": "Local acceptance echo, delay and large output; no network." },
    { "id": "propose", "kind": "tool", "entry": "propose.json", "description": "Propose an independent data or View change after returning; query its separate Action and approval." },
    { "id": "acceptance", "kind": "workflow", "entry": "workflow.md", "description": "Optional acceptance guidance; grants no authority." }
  ],
  "backend": { "command": "node", "args": ["backend.cjs"], "entry": "backend.cjs" },
  "requires": { "capabilities": ["actions.submit", "surface.stage"], "render_profiles": ["managed-v1"] }
}
